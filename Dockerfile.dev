FROM node:23.0.0-alpine3.20

WORKDIR /app

# Copia archivos de dependencias
COPY package*.json ./

# Instala dependencias
RUN npm install

# El código fuente se montará como volumen
# No copiamos el código aquí para que los cambios se reflejen en tiempo real

# Expone el puerto de Vite dev server
EXPOSE 5173

# Comando para desarrollo con hot-reload
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
